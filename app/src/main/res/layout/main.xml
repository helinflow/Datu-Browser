<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#0E0D12"
		android:orientation="horizontal"
		android:layout_weight="1">
		<FrameLayout
			android:id="@+id/tela1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			>
			<ScrollView
				android:id="@+id/vscroll1"
				android:layout_width="match_parent"
				android:layout_height="match_parent">
				<LinearLayout
					android:id="@+id/inicio"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_gravity="center_horizontal|center_vertical">
					<LinearLayout
						android:id="@+id/linear11"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="28dp"
						android:layout_marginBottom="18dp"
						android:paddingStart="20dp"
						android:paddingEnd="20dp"
						android:gravity="center_vertical"
						android:orientation="vertical">
						<TextView
							android:id="@+id/text_icon"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="@string/app_name"
							android:textSize="34sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF"
							android:shadowColor="#E6000000"
							android:shadowDx="0"
							android:shadowDy="2"
							android:shadowRadius="8"
							android:layout_gravity="center_horizontal|center_vertical" />
					</LinearLayout>
					<ImageView
                        android:id="@+id/wallpaper_image"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="176dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/datu_stat_bg"
                        android:contentDescription="Paisagem de fundo"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true" />
                    <LinearLayout
                        android:id="@+id/linear12"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<LinearLayout
							android:id="@+id/linear_pesquisa"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="60dp"
							android:background="@drawable/datu_search_bg"
							android:gravity="center_vertical"
							android:orientation="vertical"
							android:layout_gravity="center_vertical">
							<EditText
								android:id="@+id/edittext1"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:paddingStart="18dp"
								android:paddingEnd="12dp"
								android:background="@android:color/transparent"
								android:singleLine="true"
								android:imeOptions="actionSearch"
								android:gravity="center_vertical"
								android:textSize="15sp"
					android:includeFontPadding="true"
								android:textColor="#E6E0E9"
								android:hint="Pesquise ou digite um endereço"
								android:textColorHint="#CAC4D0"
								android:layout_gravity="center_horizontal|center_vertical" />
						</LinearLayout>
						<ImageView
							android:id="@+id/imageview9"
							android:layout_width="48dp"
							android:layout_height="48dp"
							android:src="@drawable/icon_arrow_forward_ios_round"
							android:scaleType="fitCenter"
							android:scaleX="0.5"
							android:scaleY="0.5"
							android:layout_gravity="center_horizontal|center_vertical"
    android:background="@drawable/datu_nav_item_bg"
    android:padding="12dp"
    android:contentDescription="Pesquisar" android:tint="#D0BCFF"
/>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear_estatisticas"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="20dp"
						android:layout_marginStart="10dp"
						android:layout_marginEnd="10dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<LinearLayout
							android:id="@+id/linear_numeros_bloqueados"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="112dp"
							android:layout_margin="6dp"
							android:background="@drawable/datu_stat_bg"
							android:padding="12dp"
							android:gravity="center"
							android:orientation="vertical"
							android:layout_gravity="center_horizontal|center_vertical">
							<TextView
								android:id="@+id/text_bloqueiados"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="●●●"
								android:textSize="16sp"
								android:textColor="#E6E0E9" />
							<TextView
								android:id="@+id/text3"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="3dp"
								android:text="Rastreadores bloqueados"
								android:textSize="11sp"
								android:textColor="#FFFFFF" android:shadowColor="#E6000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="5" android:gravity="center"
								android:textAlignment="center"
								android:maxLines="2"
								android:includeFontPadding="true" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear_numeros_bloqueiados"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="112dp"
							android:layout_margin="6dp"
							android:background="@drawable/datu_stat_bg"
							android:padding="12dp"
							android:gravity="center"
							android:orientation="vertical"
							android:layout_gravity="center_horizontal|center_vertical">
							<TextView
								android:id="@+id/text_economia"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="●●●"
								android:textSize="16sp"
								android:textColor="#E6E0E9" />
							<TextView
								android:id="@+id/text5"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="3dp"
								android:text="Dados poupados"
								android:textSize="11sp"
								android:textColor="#D0BCFF" android:gravity="center"
								android:textAlignment="center"
								android:maxLines="2"
								android:includeFontPadding="true" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</ScrollView>
		
            <TextView
                android:id="@+id/wallpaper_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="#990E0D12"
                android:text="Foto: Unsplash"
                android:textColor="#E6E0E9"
                android:textSize="11sp"
                android:elevation="4dp" />
        </FrameLayout>
		<LinearLayout
			android:id="@+id/tela2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			
			
			<android.webkit.WebView
				android:id="@+id/webview"
				android:padding="0dp"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:overScrollMode="never"
				android:scrollbars="none"
				android:saveEnabled="true" />
		</LinearLayout>
		<LinearLayout
            android:id="@+id/tela3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0E0D12"
            android:visibility="gone">
            <ScrollView
                android:id="@+id/scroll_configuracoes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="20dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/voltar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="14dp"
                            android:src="@drawable/icon_arrow_back_ios_round"
                            android:tint="#E6E0E9"
                            android:contentDescription="Voltar"/>
                        <TextView
                            android:id="@+id/text_config_titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Configurações"
                            android:textColor="#E6E0E9"
                            android:textSize="22sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/datu_chromium_search_bg">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="16dp"
                            android:src="@drawable/ic_settings_search"
                            android:tint="#CAC4D0"/>
                        <EditText
                            android:id="@+id/config_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="14dp"
                            android:background="@android:color/transparent"
                            android:singleLine="true"
                            android:textSize="16sp"
                            android:textColor="#E6E0E9"
                            android:textColorHint="#938F99"
                            android:hint="Pesquisar nas configurações"
                            android:imeOptions="actionSearch"
                            android:inputType="text"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="18dp"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/datu_chromium_profile_bg">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:text="D"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:textColor="#0E0D12"
                            android:background="@drawable/datu_chromium_brand_bg"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Datu Browser"
                                android:textSize="16sp"
                                android:textColor="#E6E0E9"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Personalize sua experiência"
                                android:textSize="13sp"
                                android:textColor="#938F99"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_heading_basic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Básico"
                        android:textColor="#D0BCFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/settings_group_appearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/datu_chromium_profile_bg">
                        <LinearLayout
                            android:id="@+id/linear_papel_parede"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:paddingStart="24dp"
                            android:paddingEnd="20dp"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_settings_image"
                                android:tint="#CAC4D0"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="24dp"
                                android:orientation="vertical">
                                <Switch
                                    android:id="@+id/switch_papel_parede"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="0dp"
                                    android:text="Imagens na página inicial"
                                    android:textSize="16sp"
                                    android:textColor="#E6E0E9"
                                    android:buttonTint="#D0BCFF"
                                    android:checked="true"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Mostrar paisagens como plano de fundo"
                                    android:textSize="13sp"
                                    android:textColor="#938F99"/>
                            </LinearLayout>
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="72dp"
                            android:background="#49454F"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_heading_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="8dp"
                        android:text="Privacidade e segurança"
                        android:textColor="#D0BCFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/settings_group_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/datu_chromium_profile_bg">
                        <LinearLayout
                            android:id="@+id/linear_anuncios"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:gravity="center_vertical"
                            android:paddingStart="24dp"
                            android:paddingEnd="20dp"
                            android:orientation="horizontal"
                            android:background="?android:attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_settings_shield"
                                android:tint="#CAC4D0"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="24dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/text1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Proteção contra anúncios"
                                    android:textSize="16sp"
                                    android:textColor="#E6E0E9"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Bloqueio, filtros e estatísticas"
                                    android:textSize="13sp"
                                    android:textColor="#938F99"/>
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/abrir"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_keyboard_arrow_down_round"
                                android:tint="#938F99"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/linear_ublock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="72dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <LinearLayout
                                android:id="@+id/linear_bloqueio_de_anuncios"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="58dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <Switch
                                    android:id="@+id/switch_bloqueio_de_anuncios"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Bloquear anúncios e rastreadores"
                                    android:textSize="15sp"
                                    android:textColor="#E6E0E9"
                                    android:buttonTint="#D0BCFF"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/linear_estatist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="54dp"
                                android:gravity="center_vertical"
                                android:orientation="vertical">
                                <Switch
                                    android:id="@+id/switch_estatisticas"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Mostrar estatísticas de bloqueio"
                                    android:textSize="15sp"
                                    android:textColor="#E6E0E9"
                                    android:buttonTint="#D0BCFF"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/linear15"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/text_ublock"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Listas de filtros"
                                    android:textSize="14sp"
                                    android:textColor="#E6E0E9"/>
                                <TextView
                                    android:id="@+id/text_porcentagem"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:text="0%"
                                    android:textSize="12sp"
                                    android:textColor="#938F99"/>
                                <TextView
                                    android:id="@+id/text_atualize"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:text="Atualizar"
                                    android:textSize="14sp"
                                    android:textColor="#D0BCFF"/>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/text_informacao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="4dp"
                                android:textSize="13sp"
                                android:textColor="#938F99"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_heading_site"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="8dp"
                        android:text="Conteúdo e permissões"
                        android:textColor="#D0BCFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/settings_group_site"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/datu_chromium_profile_bg">
                        <LinearLayout
                            android:id="@+id/linear_javascript"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="76dp"
                            android:gravity="center_vertical"
                            android:paddingStart="24dp"
                            android:paddingEnd="20dp"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_settings_tune"
                                android:tint="#CAC4D0"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="24dp"
                                android:orientation="vertical">
                                <Switch
                                    android:id="@+id/switch_javascript"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="0dp"
                                    android:text="JavaScript"
                                    android:textSize="16sp"
                                    android:textColor="#E6E0E9"
                                    android:buttonTint="#D0BCFF"
                                    android:checked="true"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Permitir que sites executem JavaScript"
                                    android:textSize="13sp"
                                    android:textColor="#938F99"/>
                            </LinearLayout>
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="72dp"
                            android:background="#49454F"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_heading_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="8dp"
                        android:text="Sobre o navegador"
                        android:textColor="#D0BCFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/settings_group_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/datu_chromium_profile_bg">
                        <TextView
                            android:id="@+id/settings_third_party_notices"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:gravity="center_vertical"
                            android:paddingStart="24dp"
                            android:paddingEnd="20dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:text="Licenças e avisos de terceiros"
                            android:textColor="#E6E0E9"
                            android:textSize="16sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_config_sem_resultados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="32dp"
                        android:text="Nenhuma configuração encontrada"
                        android:textColor="#938F99"
                        android:textSize="14sp"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/text_config_subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text=""/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
<LinearLayout
        android:id="@+id/tela4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0E0D12"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/library_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/datu_nav_item_bg"
                android:src="@drawable/ic_library_back"
                android:contentDescription="Voltar" android:tint="#D0BCFF"
/>
            <ImageView
                android:id="@+id/library_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Seção da biblioteca" />
            <TextView
                android:id="@+id/library_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="Biblioteca"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#E6E0E9" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="58dp"
            android:paddingBottom="16dp"
            android:text="Sua biblioteca no Datu"
            android:textSize="14sp"
            android:textColor="#CAC4D0" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/library_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>
    </LinearLayout>
	</LinearLayout>
<LinearLayout
				android:id="@+id/linear_barra"
				android:layout_width="match_parent"
				android:layout_height="60dp"
				android:background="@drawable/datu_toolbar_bg"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical">
				<LinearLayout
					android:id="@+id/linear_A"
					android:layout_width="match_parent"
					android:layout_height="60dp"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="center_horizontal|center_vertical">
					<ImageView
						android:id="@+id/add"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:src="@drawable/icon_add_round"
						android:scaleType="fitCenter"
						android:scaleX="0.5"
						android:scaleY="0.5"
						android:layout_gravity="center_horizontal|center_vertical"
    android:background="@drawable/datu_nav_item_bg"
    android:padding="12dp"
    android:contentDescription="Nova pesquisa" android:tint="#D0BCFF"
/>
					<TextView
						android:id="@+id/text_barra"
						android:layout_width="0dp"
						android:layout_height="48dp"
						android:padding="8dp"
						android:background="@drawable/datu_address_bg"
						android:gravity="center_vertical"
						android:text="Pesquisar ou digitar endereço"
						android:textSize="16sp"
						android:textColor="#E6E0E9"
						android:layout_gravity="center_horizontal|center_vertical"
						android:layout_weight="1"
						android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp" />
					<TextView
                        android:id="@+id/tab_counter"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/datu_tab_counter_bg"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#D0BCFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:contentDescription="Guias abertas" />
                    <ImageView
						android:id="@+id/mais"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:src="@drawable/icon_keyboard_arrow_down_round"
						android:scaleType="fitCenter"
						android:scaleX="0.5"
						android:scaleY="0.5"
						android:layout_gravity="center_horizontal|center_vertical"
    android:background="@drawable/datu_nav_item_bg"
    android:padding="12dp"
    android:contentDescription="Abrir navegação" android:tint="#D0BCFF"
/>
				</LinearLayout>
			</LinearLayout>
<LinearLayout
				android:id="@+id/linear_B"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:orientation="horizontal"
				android:gravity="center"
				android:background="#141218"
				android:paddingStart="8dp"
				android:paddingEnd="8dp">
				<ImageView android:id="@+id/toolbar_back" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:padding="12dp" android:src="@drawable/icon_arrow_back_ios_round" android:tint="#CAC4D0" android:background="@drawable/datu_nav_item_bg" android:contentDescription="Voltar página" />
				<ImageView android:id="@+id/toolbar_forward" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:padding="12dp" android:src="@drawable/icon_arrow_forward_ios_round" android:tint="#CAC4D0" android:background="@drawable/datu_nav_item_bg" android:contentDescription="Avançar página" />
				<ImageView android:id="@+id/toolbar_favorites" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:padding="10dp" android:src="@drawable/ic_library_favorite" android:tint="#D0BCFF" android:background="@drawable/datu_nav_item_bg" android:contentDescription="Favoritos" />
				<ImageView android:id="@+id/toolbar_downloads" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:padding="10dp" android:src="@drawable/ic_library_download" android:tint="#D0BCFF" android:background="@drawable/datu_nav_item_bg" android:contentDescription="Downloads" />
			</LinearLayout>
</LinearLayout>
