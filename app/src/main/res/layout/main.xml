<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#0E0D12"
		android:orientation="horizontal"
		android:layout_weight="1">
		<LinearLayout
			android:id="@+id/tela1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical">
			<ScrollView
				android:id="@+id/vscroll1"
				android:layout_width="match_parent"
				android:layout_height="match_parent">
				<LinearLayout
					android:id="@+id/inicio"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_gravity="center_horizontal|center_vertical">
					<LinearLayout
						android:id="@+id/linear11"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="28dp"
						android:layout_marginBottom="18dp"
						android:paddingStart="20dp"
						android:paddingEnd="20dp"
						android:gravity="center_vertical"
						android:orientation="vertical">
						<TextView
							android:id="@+id/text_icon"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="@string/app_name"
							android:textSize="34sp"
							android:textStyle="bold"
							android:textColor="#E6E0E9"
							android:layout_gravity="center_horizontal|center_vertical" />
					</LinearLayout>
					<ImageView
                        android:id="@+id/wallpaper_image"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="176dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/datu_stat_bg"
                        android:contentDescription="Paisagem de fundo"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true" />
                    <LinearLayout
                        android:id="@+id/linear12"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<LinearLayout
							android:id="@+id/linear_pesquisa"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="60dp"
							android:background="@drawable/datu_search_bg"
							android:gravity="center_vertical"
							android:orientation="vertical"
							android:layout_gravity="center_vertical">
							<EditText
								android:id="@+id/edittext1"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:paddingStart="18dp"
								android:paddingEnd="12dp"
								android:background="@android:color/transparent"
								android:singleLine="true"
								android:imeOptions="actionSearch"
								android:gravity="center_vertical"
								android:textSize="15sp"
					android:includeFontPadding="true"
								android:textColor="#E6E0E9"
								android:hint="Pesquise ou digite um endereço"
								android:textColorHint="#CAC4D0"
								android:layout_gravity="center_horizontal|center_vertical" />
						</LinearLayout>
						<ImageView
							android:id="@+id/imageview9"
							android:layout_width="48dp"
							android:layout_height="48dp"
							android:src="@drawable/icon_arrow_forward_ios_round"
							android:scaleType="fitCenter"
							android:scaleX="0.5"
							android:scaleY="0.5"
							android:layout_gravity="center_horizontal|center_vertical"
    android:background="@drawable/datu_nav_item_bg"
    android:padding="12dp"
    android:contentDescription="Pesquisar" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear_estatisticas"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="20dp"
						android:layout_marginStart="10dp"
						android:layout_marginEnd="10dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<LinearLayout
							android:id="@+id/linear_numeros_bloqueados"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="112dp"
							android:layout_margin="6dp"
							android:background="@drawable/datu_stat_bg"
							android:padding="12dp"
							android:gravity="center"
							android:orientation="vertical"
							android:layout_gravity="center_horizontal|center_vertical">
							<TextView
								android:id="@+id/text_bloqueiados"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="●●●"
								android:textSize="16sp"
								android:textColor="#E6E0E9" />
							<TextView
								android:id="@+id/text3"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="3dp"
								android:text="Rastreadores bloqueados"
								android:textSize="11sp"
								android:textColor="#D0BCFF" android:gravity="center"
								android:textAlignment="center"
								android:maxLines="2"
								android:includeFontPadding="true" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear_numeros_bloqueiados"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="112dp"
							android:layout_margin="6dp"
							android:background="@drawable/datu_stat_bg"
							android:padding="12dp"
							android:gravity="center"
							android:orientation="vertical"
							android:layout_gravity="center_horizontal|center_vertical">
							<TextView
								android:id="@+id/text_economia"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="●●●"
								android:textSize="16sp"
								android:textColor="#E6E0E9" />
							<TextView
								android:id="@+id/text5"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="3dp"
								android:text="Dados poupados"
								android:textSize="11sp"
								android:textColor="#D0BCFF" android:gravity="center"
								android:textAlignment="center"
								android:maxLines="2"
								android:includeFontPadding="true" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</ScrollView>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/tela2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear_barra"
				android:layout_width="match_parent"
				android:layout_height="60dp"
				android:background="@drawable/datu_toolbar_bg"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical">
				<LinearLayout
					android:id="@+id/linear_A"
					android:layout_width="match_parent"
					android:layout_height="60dp"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="center_horizontal|center_vertical">
					<ImageView
						android:id="@+id/add"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:src="@drawable/icon_add_round"
						android:scaleType="fitCenter"
						android:scaleX="0.5"
						android:scaleY="0.5"
						android:layout_gravity="center_horizontal|center_vertical"
    android:background="@drawable/datu_nav_item_bg"
    android:padding="12dp"
    android:contentDescription="Nova pesquisa" />
					<TextView
						android:id="@+id/text_barra"
						android:layout_width="0dp"
						android:layout_height="48dp"
						android:padding="8dp"
						android:background="@drawable/datu_address_bg"
						android:gravity="center_vertical"
						android:text="Pesquisar ou digitar endereço"
						android:textSize="16sp"
						android:textColor="#E6E0E9"
						android:layout_gravity="center_horizontal|center_vertical"
						android:layout_weight="1"
						android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp" />
					<ImageView
						android:id="@+id/mais"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:src="@drawable/icon_keyboard_arrow_down_round"
						android:scaleType="fitCenter"
						android:scaleX="0.5"
						android:scaleY="0.5"
						android:layout_gravity="center_horizontal|center_vertical"
    android:background="@drawable/datu_nav_item_bg"
    android:padding="12dp"
    android:contentDescription="Abrir navegação" />
				</LinearLayout>
			</LinearLayout>
			<android.webkit.WebView
				android:id="@+id/webview"
				android:padding="8dp"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:overScrollMode="never"
				android:scrollbars="none"
				android:saveEnabled="true" />
		</LinearLayout>
		<LinearLayout
            android:id="@+id/tela3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:clipToPadding="false"
            android:orientation="vertical">
            <ScrollView
                android:id="@+id/scroll_configuracoes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="28dp">

            <TextView
                android:id="@+id/text_config_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:text="Configurações"
                android:textColor="#E6E0E9"
                android:textSize="26sp"
                android:includeFontPadding="true"
                android:breakStrategy="simple"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/text_config_subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:text="Personalize sua navegação"
                android:textColor="#CAC4D0"
                android:textSize="14sp" />
			<LinearLayout
				android:id="@+id/linear_voltar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="15dp"
				android:padding="8dp"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/voltar"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/icon_arrow_back_ios_round"
					android:scaleType="fitCenter"
					android:scaleX="0.5"
					android:scaleY="0.5" />
			</LinearLayout>
			<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="Aparência"
                android:textColor="#D0BCFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/linear_papel_parede"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/datu_stat_bg"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="12dp"
                android:padding="8dp"
                android:orientation="vertical">
                <Switch
                    android:id="@+id/switch_papel_parede"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Imagens de paisagens na tela inicial"
                    android:textSize="16sp"
                    android:textColor="#E6E0E9"
                    android:checked="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="Imagens da internet, sem chave de API."
                    android:textColor="#CAC4D0"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="Privacidade e segurança"
                android:textColor="#D0BCFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/linear_javascript"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/datu_stat_bg"
				android:layout_margin="15dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<Switch
					android:id="@+id/switch_javascript"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="left"
					android:text="JavaScript"
					android:textSize="16sp"
					android:textColor="#E6E0E9"
					android:checked="true"
					android:layout_gravity="center_horizontal|center_vertical" />
			</LinearLayout>
			<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Bloqueio de anúncios"
                android:textColor="#D0BCFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/linear_anuncios"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/datu_stat_bg"
				android:layout_marginLeft="15dp"
				android:layout_marginTop="15dp"
				android:layout_marginRight="15dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/text1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="10dp"
					android:gravity="left|center_vertical"
					android:breakStrategy="simple"
					android:text="Anúncios"
					android:textSize="16sp"
					android:textColor="#E6E0E9"
					android:layout_gravity="center_horizontal|center_vertical"
					android:layout_weight="1" />
				<ImageView
					android:id="@+id/abrir"
					android:layout_width="50dp"
					android:layout_height="50dp"
					android:src="@drawable/icon_keyboard_arrow_up_round"
					android:scaleType="fitCenter"
					android:scaleX="0.5"
					android:scaleY="0.5" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear_ublock"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/datu_stat_bg"
				android:layout_marginLeft="15dp"
				android:layout_marginRight="15dp"
				android:layout_marginBottom="15dp"
				android:padding="8dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear_bloqueio_de_anuncios"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal">
					<Switch
						android:id="@+id/switch_bloqueio_de_anuncios"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="left"
						android:text="Bloqueio de anúncios"
						android:textSize="16sp"
						android:textColor="#E6E0E9"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear_estatist"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="left"
					android:orientation="vertical">
					<Switch
						android:id="@+id/switch_estatisticas"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="left"
						android:text="Status"
						android:textSize="16sp"
						android:textColor="#E6E0E9"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear15"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/text_ublock"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="left"
						android:text="Filtros"
						android:textSize="16sp"
						android:textColor="#E6E0E9"
						android:layout_gravity="center_horizontal|center_vertical"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/text_porcentagem"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="0%"
						android:textSize="12sp"
						android:textColor="#E6E0E9"
						android:layout_gravity="center_horizontal|center_vertical" />
					<TextView
						android:id="@+id/text_atualize"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Atualizar"
						android:textSize="16sp"
						android:textColor="#E6E0E9"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<TextView
					android:id="@+id/text_informacao"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="15dp"
					android:layout_marginRight="15dp"
					android:padding="8dp"
					android:textSize="16sp"
					android:textColor="#E6E0E9" />
			</LinearLayout>
                </LinearLayout>
            </ScrollView>
		</LinearLayout>
    <LinearLayout
        android:id="@+id/tela4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0E0D12"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/library_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/datu_nav_item_bg"
                android:src="@drawable/ic_library_back"
                android:contentDescription="Voltar" />
            <ImageView
                android:id="@+id/library_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Seção da biblioteca" />
            <TextView
                android:id="@+id/library_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="Biblioteca"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#E6E0E9" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="58dp"
            android:paddingBottom="16dp"
            android:text="Sua biblioteca no Datu"
            android:textSize="14sp"
            android:textColor="#CAC4D0" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/library_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>
    </LinearLayout>
	</LinearLayout>
</LinearLayout>
